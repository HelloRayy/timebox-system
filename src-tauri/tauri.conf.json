{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Timebox Ray",
  "version": "0.1.0",
  "identifier": "com.rayhan.timebox-ray",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:3000",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../apps/web/build/client"
  },
  "app": {
    "windows": [
      {
        "title": "Timebox Ray",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
